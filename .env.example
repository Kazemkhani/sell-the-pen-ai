# ---------------------------------------------------------------------------
# Frontend environment — copy to `.env` and fill in your own values.
# Never commit `.env`. Only this template is tracked.
# ---------------------------------------------------------------------------

# Vapi (https://vapi.ai) — voice AI used for the live cold-call simulation.
# The PUBLIC key is browser-safe by design, but you MUST restrict it to
# your domain(s) in the Vapi dashboard to prevent quota abuse.
VITE_VAPI_PUBLIC_KEY=pk_your_vapi_public_key_here
VITE_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Backend API base URL. Leave as-is for local development.
VITE_API_BASE_URL=http://localhost:3000/api

# Demo controls — toggle to true to bypass live calls and use a fixture
# transcript (handy for offline demos / screenshots).
VITE_DUMMY=false
VITE_TYPE=GOOD   # GOOD | BAD — which fixture transcript to load
