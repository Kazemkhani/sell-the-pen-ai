# ---------------------------------------------------------------------------
# Backend environment — copy to `.env.local` (or `.env`) and fill in values.
# Never commit a populated env file. Only this template is tracked.
# ---------------------------------------------------------------------------

# OpenAI — used for transcript analysis, scoring and feedback generation.
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Vapi server SDK (optional — only required if you wire server-side
# webhooks or programmatic call control).
VAPI_API_KEY=your_vapi_private_key_here

# Deepgram (optional — only required if you swap Vapi's STT for Deepgram).
DEEPGRAM_API_KEY=your_deepgram_key_here

# Server
PORT=3000

# Database (optional for the hackathon scope; schema lives in app/db/schema.sql).
DATABASE_URL=postgresql://user:password@localhost:5432/sellpenai
